# ---------------------------------------------------------------------------
# RideX environment configuration (copy to .env and adjust per environment)
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins for CORS.
# Leave empty in development to allow localhost automatically.
CORS_ORIGIN=
# Set to 1 only when running behind a trusted reverse proxy (nginx, Render, Heroku, etc.)
TRUST_PROXY=0

# Data
# Path to the JSON data store. Defaults to server/data/mobility_store.json.
RIDEX_DB_FILE=
# Seed demo users/rides/drivers. Production always disables demo data.
SEED_DEMO_USERS=true
# Wallet credit granted on sign-up. Set to 0 in production.
SIGNUP_BONUS=100

# Frontend (build-time, consumed by react-scripts)
# Leave blank to use same-origin /api in production and http://localhost:5000/api in development.
REACT_APP_API_URL=
# Leave blank to derive ws(s)://<current-host>/ws in production and ws://localhost:5000/ws in development.
REACT_APP_WS_URL=
# Show demo login helpers in the auth modal. Disabled in production unless set to "true".
REACT_APP_ENABLE_DEMO_LOGIN=false
