        <mxCell id="gw_security_middleware" value="&lt;b&gt;Security &amp; Middleware Filter&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;• X-Request-ID Correlation&lt;br/&gt;• Helmet Security Headers&lt;br/&gt;• Strict CORS Policy Enforcement&lt;br/&gt;• Token-Bucket Rate Limiter (300 req/min)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#991B1B;align=left;spacingLeft=15;" parent="lane_gateway" vertex="1">
