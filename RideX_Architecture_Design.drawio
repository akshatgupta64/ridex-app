        <mxCell id="gw_ws_ingress" value="&lt;b&gt;WebSocket Connection Gateway&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;• Full-Duplex Persistent WSS Engine&lt;br/&gt;• 30-Second Heartbeat Ping/Pong&lt;br/&gt;• Room-Based Isolation (&lt;code&gt;subscribe_ride&lt;/code&gt;)&lt;br/&gt;• Zero Broadcast Storm Routing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#064E3B;align=left;spacingLeft=15;" parent="lane_gateway" vertex="1">
