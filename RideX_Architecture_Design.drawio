        <mxCell id="gw_load_balancer" value="&lt;b&gt;Envoy / NGINX Load Balancer&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;High-Throughput Layer 7 Proxy&lt;br/&gt;• HTTP/2 &amp; WSS Termination&lt;br/&gt;• Consistent Hashing on City ID&lt;br/&gt;• SSL/TLS Offloading&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#1E40AF;align=left;spacingLeft=15;" parent="lane_gateway" vertex="1">
