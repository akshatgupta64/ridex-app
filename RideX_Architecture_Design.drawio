</mxCell>
        <mxCell id="lane_services" value="⚙️ Core Microservices Application Tier (Node.js / Express)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;rounded=1;arcSize=8;collapsible=0;fontFamily=Helvetica;fontStyle=1;fontSize=13;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;" parent="1" vertex="1">
