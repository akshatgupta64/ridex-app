        <mxCell id="db_postgres_primary" value="&lt;b&gt;PostgreSQL + PostGIS (Primary)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;Sharded by &lt;code&gt;city_id&lt;/code&gt; (Geographic Sharding)&lt;br/&gt;• ACID Relational Store&lt;br/&gt;• Spatial Engine (GIST Indexes, &lt;code&gt;ST_Buffer&lt;/code&gt;, &lt;code&gt;ST_Contains&lt;/code&gt;)&lt;br/&gt;• Tables: &lt;code&gt;users&lt;/code&gt;, &lt;code&gt;rides&lt;/code&gt;, &lt;code&gt;ride_bids&lt;/code&gt;, &lt;code&gt;carpools&lt;/code&gt;, &lt;code&gt;wallet_ledger&lt;/code&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#1E3A8A;align=left;spacingLeft=15;" parent="lane_persistence" vertex="1">
  <mxGeometry x="25" y="50" width="330" height="140" as="geometry" />
</mxCell>
        <mxCell id="db_postgres_replica" value="&lt;b&gt;PostgreSQL Read Replicas (x3)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;Cross-AZ Read-Only Pool&lt;br/&gt;• High Throughput Ride Search&lt;br/&gt;• Historical Profile &amp; Trip Queries&lt;br/&gt;• Streaming WAL Replication (&lt; 50ms lag)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#312E81;align=left;spacingLeft=15;" parent="lane_persistence" vertex="1">
  <mxGeometry x="25" y="215" width="330" height="110" as="geometry" />
</mxCell>
        <mxCell id="ext_osrm" value="&lt;b&gt;OSRM / Mapbox Road API&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;• Real Road Network Graph&lt;br/&gt;• Polyline Geometry &amp; Distance&lt;br/&gt;• Live Traffic Duration Routing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#581C87;align=left;spacingLeft=15;" parent="lane_persistence" vertex="1">
