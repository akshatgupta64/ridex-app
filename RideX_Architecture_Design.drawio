        <mxCell id="svc_bidding" value="&lt;b&gt;inDrive Dynamic Bidding Engine&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;code&gt;/api/rides/request&lt;/code&gt; • &lt;code&gt;/api/rides/:id/bid&lt;/code&gt; • &lt;code&gt;/api/rides/:id/accept-bid&lt;/code&gt;&lt;br/&gt;• Fare Bounds Validation [0.6x - 3.0x Base]&lt;br/&gt;• 25-Second Bid Expiry TTL&lt;br/&gt;• Atomic Lock Ride Claiming (Redlock + SQL)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#78350F;align=left;spacingLeft=15;" parent="lane_services" vertex="1">
  <mxGeometry x="25" y="45" width="510" height="95" as="geometry" />
</mxCell>
        <mxCell id="svc_telemetry" value="&lt;b&gt;Real-Time Telemetry &amp; GPS Streamer&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;code&gt;ws://.../ws&lt;/code&gt; • Event: &lt;code&gt;driver_location&lt;/code&gt;&lt;br/&gt;• Peak Ingestion: 666,666 QPS (64-byte payload)&lt;br/&gt;• Dead-Reckoning Extrapolation on packet loss&lt;br/&gt;• Anti-Spoofing &amp; Role-based Telemetry Guard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#065F46;align=left;spacingLeft=15;" parent="lane_services" vertex="1">
  <mxGeometry x="25" y="155" width="510" height="95" as="geometry" />
</mxCell>
        <mxCell id="svc_geo_routing" value="&lt;b&gt;Geospatial Indexing &amp; Routing Service&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;code&gt;/api/rides/nearby-drivers&lt;/code&gt; • &lt;code&gt;/api/geo/route&lt;/code&gt;&lt;br/&gt;• Uber H3 Hexagonal Spatial Index (Res 8, 3km radius = k-ring 3)&lt;br/&gt;• Sub-0.5ms Spatial Radius Lookup&lt;br/&gt;• True Road Path Polyline via OSRM Graph Engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#581C87;align=left;spacingLeft=15;" parent="lane_services" vertex="1">
  <mxGeometry x="25" y="265" width="510" height="95" as="geometry" />
</mxCell>
        <mxCell id="svc_carpooling" value="&lt;b&gt;Intercity Carpool Corridor Service&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;code&gt;/api/carpools/publish&lt;/code&gt; • &lt;code&gt;/api/carpools/search&lt;/code&gt; • &lt;code&gt;/api/carpools/:id/book&lt;/code&gt;&lt;br/&gt;• PostGIS &lt;code&gt;ST_Buffer(route, 5000m)&lt;/code&gt; Polygon Generation&lt;br/&gt;• Detour Inclusion Math (&lt;code&gt;ST_Contains&lt;/code&gt;, Max 15% Detour)&lt;br/&gt;• Overbooking Prevention via Atomic Decrement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#1E3A8A;align=left;spacingLeft=15;" parent="lane_services" vertex="1">
  <mxGeometry x="25" y="375" width="510" height="95" as="geometry" />
</mxCell>
        <mxCell id="svc_wallet" value="&lt;b&gt;Financial Ledger &amp; Settlement Service&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;code&gt;/api/wallet/balance&lt;/code&gt; • &lt;code&gt;/api/wallet/settle-ride&lt;/code&gt; • &lt;code&gt;/api/wallet/topup&lt;/code&gt;&lt;br/&gt;• Double-Entry Bookkeeping Ledger (Immutable Entries)&lt;br/&gt;• Driver Payout (85%) &amp; Platform Fee (15%) Split&lt;br/&gt;• Zero Double-Spend via Client &lt;code&gt;idempotencyKey&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#831843;align=left;spacingLeft=15;" parent="lane_services" vertex="1">
  <mxGeometry x="25" y="485" width="510" height="95" as="geometry" />
</mxCell>
        <mxCell id="svc_safety" value="&lt;b&gt;Safety Shield &amp; Verification Service&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;code&gt;/api/rides/:id/verify-otp&lt;/code&gt; • &lt;code&gt;/api/contact/sos&lt;/code&gt;&lt;br/&gt;• Cryptographic 4-Digit Ride Start OTP Verification&lt;br/&gt;• One-Click Live SOS Web Link Generation&lt;br/&gt;• Automated Driver Identity &amp; License Verification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#7F1D1D;align=left;spacingLeft=15;" parent="lane_services" vertex="1">
  <mxGeometry x="25" y="595" width="510" height="95" as="geometry" />
</mxCell>
        <mxCell id="lane_cache_mq" value="⚡ Distributed Cache &amp; Message Broker" style="swimlane;whiteSpace=wrap;html=1;startSize=32;rounded=1;arcSize=8;collapsible=0;fontFamily=Helvetica;fontStyle=1;fontSize=13;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;" parent="1" vertex="1">
  <mxGeometry x="1540" y="120" width="400" height="860" as="geometry" />
</mxCell>
        <mxCell id="mq_kafka" value="&lt;b&gt;Apache Kafka Event Streaming Cluster&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;High-Throughput Partitioned Event Log&lt;br/&gt;• Topic: &lt;code&gt;driver-locations&lt;/code&gt; (16 partitions)&lt;br/&gt;• Topic: &lt;code&gt;ride-requests-fanout&lt;/code&gt;&lt;br/&gt;• Topic: &lt;code&gt;bids-lifecycle&lt;/code&gt;&lt;br/&gt;• Topic: &lt;code&gt;wallet-settlements&lt;/code&gt;&lt;/font&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=20;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#4C1D95;align=left;spacingLeft=15;" parent="lane_cache_mq" vertex="1">
  <mxGeometry x="25" y="50" width="350" height="120" as="geometry" />
</mxCell>
        <mxCell id="cache_redis_cluster" value="&lt;b&gt;Redis In-Memory Cluster &amp;amp; Pub/Sub&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;Sub-Millisecond Read/Write Cache&lt;br/&gt;• Uber H3 Driver Geospatial Sets (&lt;code&gt;GEOADD / GEORADIUS&lt;/code&gt;)&lt;br/&gt;• Active Bids Hash (&lt;code&gt;TTL = 25s&lt;/code&gt;)&lt;br/&gt;• Redlock Distributed Mutex Manager (&lt;code&gt;lock:ride:{id}&lt;/code&gt;)&lt;br/&gt;• Realtime WebSocket Backplane Fabric&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#991B1B;align=left;spacingLeft=15;" parent="lane_cache_mq" vertex="1">
  <mxGeometry x="25" y="200" width="350" height="130" as="geometry" />
</mxCell>
        <mxCell id="cache_session" value="&lt;b&gt;Idempotency &amp; Token Store&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;• &lt;code&gt;SET key val NX EX 86400&lt;/code&gt;&lt;br/&gt;• Rate Limit Token Buckets&lt;br/&gt;• Driver Ping Cooldown Flags&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#78350F;align=left;spacingLeft=15;" parent="lane_cache_mq" vertex="1">
  <mxGeometry x="25" y="360" width="350" height="90" as="geometry" />
</mxCell>
        <mxCell id="lane_persistence" value="🗄️ Persistence &amp; External Providers" style="swimlane;whiteSpace=wrap;html=1;startSize=32;rounded=1;arcSize=8;collapsible=0;fontFamily=Helvetica;fontStyle=1;fontSize=13;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;" parent="1" vertex="1">
  <mxGeometry x="1980" y="120" width="380" height="860" as="geometry" />
